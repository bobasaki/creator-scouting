# This repo does not load a root .env file automatically.
# Use this file as a reference and copy values into the app-specific env files.

# apps/api/.env
DATABASE_URL="file:./dev.db"
YOUTUBE_API_KEY="your-youtube-api-key"
OPENAI_API_KEY="your-openai-api-key"
HOST="0.0.0.0"
PORT="3000"
LOG_LEVEL="info"
# Optional. Only needed if a browser should call the API directly.
CORS_ALLOWED_ORIGINS="http://localhost:3001,http://127.0.0.1:3001"

# apps/ui/.env.local
BACKEND_URL="http://127.0.0.1:3000"
# Optional. Add LAN origins when opening the Next dev server from another device.
DEV_ALLOWED_ORIGINS="http://localhost:3001,http://127.0.0.1:3001"
