DATABASE_URL="file:./dev.db"
YOUTUBE_API_KEY="your-youtube-api-key"
OPENAI_API_KEY="your-openai-api-key"
HOST="0.0.0.0"
PORT="3000"
LOG_LEVEL="info"
# Optional. Only needed if a browser should call the API directly.
CORS_ALLOWED_ORIGINS="http://localhost:3001,http://127.0.0.1:3001"

# Legacy/internal run endpoints. Leave public access off for catalog-first deployments.
RUNS_API_PUBLIC_ENABLED="false"
# Optional shared token for non-private internal callers that still need /runs.
RUNS_API_INTERNAL_TOKEN=""

# Queue workers
SCHEDULER_AUTO_DISPATCH_ENABLED="true"
SCHEDULER_AUTO_DISPATCH_INTERVAL_MS="60000"
SCHEDULER_AUTO_DISPATCH_LIMIT="10"

# Optional recurring bootstraps. Leave false if you want to start discovery/maintenance manually.
SCHEDULER_AUTO_DISCOVERY_ENABLED="false"
SCHEDULER_AUTO_DISCOVERY_INTERVAL_MS="21600000"
SCHEDULER_AUTO_DISCOVERY_LIMIT="20"
SCHEDULER_AUTO_REFRESH_ENABLED="false"
SCHEDULER_AUTO_REFRESH_INTERVAL_MS="3600000"
SCHEDULER_AUTO_REFRESH_LIMIT="25"
SCHEDULER_AUTO_REFRESH_STALE_AFTER_DAYS="7"
SCHEDULER_AUTO_ENRICH_ENABLED="false"
SCHEDULER_AUTO_ENRICH_INTERVAL_MS="3600000"
SCHEDULER_AUTO_ENRICH_LIMIT="25"
SCHEDULER_AUTO_ENRICH_STALE_AFTER_DAYS="14"
SCHEDULER_AUTO_ENRICH_MISSING_ONLY="false"
